{
  "manifest_version": 3,
  "name": "Linguist - Flashcard Translator",
  "version": "0.1.0",
  "description": "Tradutor que permite salvar palavras como flashcards (MVP).",
  "permissions": [
    "storage",
    "tts"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meus Flashcards"
  }
}
